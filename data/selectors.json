      {"do": "click", "selector": "mat-dialog-container button:text-matches(\"^\\\\s*(Bestätigen|Ordern|Order aufgeben|Jetzt ordern|Kaufen|Ja|Weiter)\\\\s*$\", \"i\")", "optional": true}
    ],
    "sell_steps": [
      {"do": "click", "selector": "label[for=\"market\"]"},
      {"do": "click", "selector": "label[for=\"{tab}\"]"},
      {"do": "click", "selector": "tr.mat-mdc-row:has-text(\"{isin}\") button[aria-label^=\"Kauf \"]"},
      {"do": "wait", "selector": "app-order input#quantity"},
      {"do": "click", "selector": "app-order label.selector-item_label:text-matches(\"^\\\\s*Verkauf\", \"i\")"},
      {"do": "fill", "selector": "app-order input#quantity", "value": "{shares}"},
      {"do": "click", "selector": "app-order label[for=\"subTypeBest\"]"},
      {"do": "click", "selector": "app-order label[for=\"valid1\"]"},
      {"do": "click", "selector": "app-order button.order-button"},
      {"do": "click", "selector": "mat-dialog-container button:text-matches(\"^\\\\s*(Bestätigen|Ordern|Order aufgeben|Jetzt ordern|Verkaufen|Ja|Weiter)\\\\s*$\", \"i\")", "optional": true}
    ],
    "stop_steps": [],
    "confirmation_marker": ":is(mat-dialog-container, .mat-mdc-snack-bar-container, simple-snack-bar, .toast-message, .alert-success):visible",
    "error_pattern": "fehler|abgelehnt|nicht möglich|nicht ausreichend|nicht genug|unzureichend|ungültig|error|failed|insufficient"
  }
