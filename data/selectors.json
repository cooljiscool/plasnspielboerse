    "test_marker": "input#training.active",
    "echt_marker": "input#depot.active",
    "test_content": "app-training-depot app-portfolio",
    "echt_content": "app-depot1 app-portfolio"
  },
  "portfolio": {
    "url": "https://trading.planspiel-boerse.de/web/account",
    "cash_selector": "div:has(> span:text-is(\"Barbestand\")) > p:has-text(\"€\")",
    "total_selector": "div:has(> span:text-is(\"Gesamtdepotwert\")) > p:has-text(\"€\")",
    "ready_selector": "#table tr.mat-mdc-row, app-portfolio p:has-text(\"Erster Handelstag\")",
    "row_selector": "#table tr.mat-mdc-row:not(.mat-mdc-no-data-row)",
