    "test_steps": [
      {"do": "click", "selector": "a.nav-link[href=\"/web/account\"]"},
      {"do": "click", "selector": "label[for=\"training\"]"}
    ],
    "echt_steps": [
      {"do": "click", "selector": "a.nav-link[href=\"/web/account\"]"},
      {"do": "click", "selector": "label[for=\"depot\"]"}
