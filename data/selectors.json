    "shares_cell": ".cdk-column-quantity",
    "avg_price_cell": ".cdk-column-buyvalue"
  },
  "order": {
    "_hinweis": "Kauf: Marktübersicht, Reiter des Index (tabs), Zeile mit der ISIN, Schaltfläche 'Kauf <Name>', dann die Kaufmaske (app-order). Die Schritte des Verkaufs (sell_steps) sind GESCHÄTZT: angenommen wird, dass dieselbe Maske bei einem gehaltenen Titel die Orderart 'Verkauf' anbietet.",
    "tabs": {
      "dax": "DAX",
      "mdax": "MDAX",
      "sdax": "SDAX",
      "tecdax": "TECDAX",
      "eurostoxx50": "EuroStoxx50",
      "dow": "Dow Jones",
      "nasdaq100": "Nasdaq 100",
      "gci": "Global Challenges Index",
      "atx": "ATX",
      "ftsemib": "FTSE MIB",
      "luxx": "LuxX",
      "europa": "Selection Europe"
    },
    "buy_steps": [
      {"do": "click", "selector": "label[for=\"market\"]"},
      {"do": "click", "selector": "label[for=\"{tab}\"]"},
      {"do": "click", "selector": "tr.mat-mdc-row:has-text(\"{isin}\") button[aria-label^=\"Kauf \"]"},
      {"do": "wait", "selector": "app-order input#quantity"},
      {"do": "click", "selector": "app-order label[for=\"type1\"]"},
      {"do": "fill", "selector": "app-order input#quantity", "value": "{shares}"},
      {"do": "click", "selector": "app-order label[for=\"subTypeBest\"]"},
      {"do": "click", "selector": "app-order label[for=\"valid1\"]"},
