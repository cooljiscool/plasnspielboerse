      {"do": "fill", "selector": "SELEKTOR_STUECKZAHL", "value": "{shares}"},
      {"do": "click", "selector": "SELEKTOR_ORDER_ABSENDEN"},
      {"do": "click", "selector": "SELEKTOR_BESTAETIGEN"}
