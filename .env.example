# Kopieren nach .env und Passwort ändern (mind. 8 Zeichen, besser lang und zufällig).
DASHBOARD_PASSWORD=bitte-aendern-langes-zufaelliges-passwort
# Nur auf 1 setzen, wenn das Dashboard ausschließlich über https erreichbar ist (z. B. Tunnel oder Reverse Proxy):
DASHBOARD_HTTPS=0

# --- Optional (Erklärung im README) ---
# Kontakt für die kostenlosen SEC-Insiderdaten (die SEC verlangt Name und E-Mail bei automatischen Abfragen). Ohne Angabe bleiben sie aus.
# Geht auch im Dashboard unter Einstellungen.
# SEC_USER_AGENT=Vorname Nachname mail@example.org
# Quiver Quantitative (kostenpflichtig, gegen die echte Schnittstelle ungetestet); auch im Dashboard eintragbar.
# QUIVER_API_TOKEN=
# Nur-Lese-Anbindung eines MCP-Servers an die Recherche (z. B. Liquid). Nur mit Umfang "read" anmelden, Werkzeuge einzeln und ohne Platzhalter nennen.
# BOT_RESEARCH_MCP_CONFIG=data/mcp_readonly.json
# BOT_RESEARCH_MCP_TOOLS=mcp__liquid__<werkzeug>
# Titel je Recherche-Aufruf (Standard 3; bei vielen Titeln in einem Aufruf sucht Claude nur oberflächlich):
# BOT_RESEARCH_BATCH=3
# Nachhaltigkeitswertung: so viele der 6 Depotplätze für Titel mit Stern reservieren (0 bis 6, Standard 0; kostet Rang in der Gesamtwertung, siehe README). Geht auch im Dashboard.
# BOT_NH_SLOTS=0
# Stil: sicher (Standard) oder angriff (5 volatile Titel, keine Volatilitätsbremse; Chance auf Spitzenplätze, höhere Streuung, siehe README). Geht auch im Dashboard.
# BOT_STYLE=sicher
